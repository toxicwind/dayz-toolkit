# dayz-toolkit environment template
# Copy to .env and fill in real values. NEVER commit .env.

# ============ DISCORD BOT ============
# Get token from: https://discord.com/developers/applications
DISCORD_TOKEN=
DISCORD_GUILD_ID=

# ============ NITRADO (game-server host) ============
# https://api.nitrado.net — token from your Nitrado account
NITRADO_API_TOKEN=
NITRADO_SERVICE_ID=
NITRADO_EMAIL=

# ============ DAYZ SERVER / RCON ============
DAYZ_HOST=
DAYZ_QUERY_PORT=27016
DAYZ_RCON_HOST=
DAYZ_RCON_PORT=2302
DAYZ_RCON_PASSWORD=

# ============ FTP (server file access) ============
DAYZ_FTP_HOST=
DAYZ_FTP_PORT=21
DAYZ_FTP_USER=
DAYZ_FTP_PASS=

# ============ MYSQL (server database) ============
DAYZ_MYSQL_HOST=
DAYZ_MYSQL_PORT=3306
DAYZ_MYSQL_USER=
DAYZ_MYSQL_PASS=
DAYZ_MYSQL_DB=

# ============ SAFETY ============
# 1 = automation may never FTP-push to the server (default, keep it)
DISABLE_FTP_PUSH=1
