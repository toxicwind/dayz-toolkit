# dedi-ops Local Environment Configuration
# =========================================
# Copy this to .env and fill in your local values
# .env is in .gitignore and should NEVER be committed
#
# Use for:
# - Discord bot tokens
# - API keys (Nitrado, Steam, etc.)
# - Database connection strings
# - Local port overrides
#
# For deployment-wide settings, see: config/environments/*.yml

# ============ DISCORD BOT ============
# Get token from: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_LOG_CHANNEL=

# ============ GAME SERVER APIs ============
# Nitrado API (https://www.nitrado.net/en/profile/api)
NITRADO_API_KEY=

# A2S Query (game server direct query)
A2S_QUERY_PORT=27015

# ============ DATABASE ============
# Local development (SQLite):
DATABASE_URL=sqlite:///data/nexus.db

# Or PostgreSQL (docker-compose handles this):
# DATABASE_URL=postgresql://dedi:password@db:5432/nexus

# ============ DEPLOYMENT ============
# Which environment config to load
DEPLOYMENT_ENV=local
# Options: local, staging, production

# Dedicated host SSH connection defaults (use direct server IP, not proxied DNS)
DEDI_HOST=172.96.160.178
DEDI_USER=root
DEDI_SSH_KEY_FILE=/home/toxic/.ssh/dedi_ops_ansible_ed25519
# Public URL/domain (optional, for HTTP checks)
DEDI_PUBLIC_HOST=agent.mildlyawesome.com
# Set to 1 only if key auth is unavailable
DEDI_USE_PASSWORD_AUTH=0
# Optional fallback for password mode
DEDI_PASSWORD=

# Log level for debugging
LOG_LEVEL=DEBUG
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ============ SERVICES ============
# Web Dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=3000

# Bot
BOT_HOST=0.0.0.0
BOT_PORT=5000

# Nexus Orchestrator API
NEXUS_API_HOST=localhost
NEXUS_API_PORT=8000

# ============ INFRASTRUCTURE (Docker Compose) ============
# Auth / deploy control
DEDI_OPS_AUTH_TOKEN=your_new_bearer_token_here
DEDI_OPS_AUTH_USERNAME=ops
DEDI_OPS_AUTH_PASSWORD=replace_with_strong_password

# Cloudflare (canonical names)
CLOUDFLARE_EMAIL=
CLOUDFLARE_PASSWORD=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token_here

# Backward-compatible alias for older scripts/stacks (prefer CLOUDFLARE_TUNNEL_TOKEN)
TUNNEL_TOKEN=

# Database
MYSQL_ROOT_PASSWORD=your_mysql_password_here
ACME_EMAIL=admin@mildlyawesome.com
MYSQL_USER=dedi_admin
MYSQL_PASSWORD=change_this
DOKPLOY_DB_URL=postgres://dokploy:password@dokploy-postgres:5432/dokploy

# Registry
REGISTRY_AUTH_TOKEN=generate_via_htpasswd
GHCR_USERNAME=toxicwind
GHCR_PULL_TOKEN=ghp_replace_with_read_packages_token

# ============ AUTONOMOUS DEPLOY WEBHOOK ============
DEDI_DEPLOY_WEBHOOK_SECRET=replace_with_strong_random_secret
DEDI_DEPLOY_WEBHOOK_TTL_SECONDS=300
DEDI_ALLOW_INFRA_DEPLOY=0
DEDI_DEPLOY_CALLBACK_SECRET=
DEDI_REPO_ROOTS=/home/toxic/apex-workspace/projects/github/toxicwind:/home/toxic/apex-workspace/projects:/home/toxic/development

# ============ OPTIONAL: LOCAL OVERRIDES ============
# These override values in config/environments/local.yml
# Only set if you need to deviate from defaults

# RCON_PASSWORD=
# FTP_HOST=
# FTP_USER=
# FTP_PASSWORD=
# BACKUP_SCHEDULE=0 2 * * *
