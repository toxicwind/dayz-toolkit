# =================================================================
# CORE INFRASTRUCTURE
# =================================================================
# Docker & Portainer
COMPOSE_PROJECT_NAME=dayz_ops

# =================================================================
# BACKEND (PYTHON BOT)
# =================================================================
# Discord Bot Credentials
EZSTREET_DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_IDS=

# Nitrado Server API
EZSTREET_NITRADO_TOKEN=

# DayZ Server FTP Access
EZSTREET_FTP_HOST=
EZSTREET_FTP_USER=
EZSTREET_FTP_PASSWORD=

# DayZ Server RCON
DAYZ_RCON_PORT=
DAYZ_RCON_PASSWORD=

# Database (MySQL)
EZSTREET_MYSQL_HOST=mysql
EZSTREET_MYSQL_DATABASE=dayz_ops
EZSTREET_MYSQL_USER=dayz
EZSTREET_MYSQL_PASSWORD=

# =================================================================
# FRONTEND (NEXT.JS DASHBOARD)
# =================================================================
# Bot & Dashboard Service URLs (production overrides localhost defaults)
NEXT_PUBLIC_API_URL=http://localhost:43300

# Clerk.dev Authentication (REQUIRED FOR DASHBOARD)
# Get these from your Clerk Dashboard: https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional: For admin access control in middleware
CLERK_CHRIS_ID=

# Clerk Redirect URLs (defaults are usually fine)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/auth/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/auth/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard/overview"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard/overview"

# =================================================================
# DEVELOPMENT & DEBUGGING
# =================================================================
# Set to "1" to disable FTP operations for local dev
DISABLE_FTP_PUSH=
# Set to "true" to enable self-play features
ENABLE_SELFPLAY=
# For Next.js hot-reloading in Docker
WATCHPACK_POLLING=true
